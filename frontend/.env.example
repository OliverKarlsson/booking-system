# Origin of the API. Leave unset in dev and in Docker: the app and the API share an
# origin there (the Vite dev proxy / the reverse proxy), so requests go to /v1/... on
# the same host and no CORS configuration is involved.
# VITE_API_URL=https://api.example.com

# Where `npm run dev` proxies /v1 to. Defaults to the API's docker-compose port.
# VITE_API_PROXY_TARGET=http://localhost:5006
