{
  "name": "minut-booking-system",
  "version": "1.0.0",
  "description": "Booking system — npm workspace root (shared contract, API, web client)",
  "private": true,
  "license": "ISC",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
