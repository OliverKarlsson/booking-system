{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /*
     * CommonJS output. The base config deliberately leaves `module` to each workspace;
     * the backend runs directly on Node with no bundler, and CJS keeps `__dirname` (used
     * to locate schema.sql) and interop with `pg`/`express` free of ceremony. The
     * frontend makes the opposite choice for the opposite reasons.
     *
     * `node16` rather than the legacy `node` resolution — same CommonJS emit, but it
     * honours the `exports` map in package.json. Several current dependencies
     * (express-rate-limit, superagent) publish their CJS type declarations *only* under
     * an `exports` condition, and the legacy resolver cannot see them: it falls back to
     * `main`, finds no `types`, and silently types the module as `any`. That is a bug
     * factory, not a warning.
     */
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "types": ["node"],

    "rootDir": "./src",
    "outDir": "./dist",

    /* Emitting declarations for an application (rather than a library) buys nothing and
     * costs build time; @booking/shared is where declarations matter. */
    "declaration": false,
    "declarationMap": false,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"]
}
