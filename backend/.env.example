# Copy to .env for local development outside Docker. docker-compose.yml sets these itself.
#
# Port 5433 is the host-side mapping of the compose `db` service (see docker-compose.yml);
# inside the compose network the API uses host `db` and port 5432.
DATABASE_URL=postgres://booking:booking@localhost:5433/booking

NODE_ENV=development
PORT=5006

# '*' or a comma-separated allow-list, e.g. http://localhost:5173
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
PG_POOL_MAX=10

SEED_ON_STARTUP=true
